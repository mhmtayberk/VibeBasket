{
  "name": "@vibebasket/core",
  "version": "0.1.0",
  "description": "Core types, schemas and logic for VibeBasket",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./local-mcp-snippets": "./src/local-mcp-snippets.ts",
    "./db": "./src/db/index.ts"
  },
  "scripts": {
    "build": "node ../../scripts/run-tsup.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -b"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^5.1.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
