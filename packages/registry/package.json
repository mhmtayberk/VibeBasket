{
  "name": "@vibebasket/registry",
  "version": "0.1.0",
  "description": "Catalog registry and sync logic for VibeBasket",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/run-tsup.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
